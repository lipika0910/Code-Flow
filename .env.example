# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration
# Local SQLite fallback: leave DATABASE_URL empty or set to server/data/codeflow.sqlite3
# Production PostgreSQL example: postgresql://username:password@hostname:5432/codeflow_db
DATABASE_URL=

# Authentication Secrets
# Generate a secure random string (e.g. openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_change_in_production
COOKIE_SECRET=your_cookie_secret_key_change_in_production

# Initial Admin Seed Credentials
ADMIN_EMAIL=admin@codeflow.edu
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_NAME=CodeFlow Administrator
